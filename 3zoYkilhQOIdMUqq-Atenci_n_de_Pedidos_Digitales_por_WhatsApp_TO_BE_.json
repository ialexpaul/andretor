    {
      "parameters": {
        "jsCode": "const base = $('Determinar Fase').first().json;\nconst g = $input.first().json || {};\nlet raw = '';\nif (typeof g.content === 'string') { raw = g.content; }\nelse if (typeof g.text === 'string') { raw = g.text; }\nelse if (g.content && g.content[0] && g.content[0].text) { raw = g.content[0].text; }\nelse { raw = JSON.stringify(g); }\nlet extracted = {};\ntry { const m = raw.match(/\\{[\\s\\S]*\\}/); if (m) { extracted = JSON.parse(m[0]); } } catch (e) { extracted = {}; }\nconst operacion = String(extracted.operacion || extracted.numero_operacion || '').replace(/\\s/g, '');\nconst monto = (extracted.monto != null) ? extracted.monto : null;\nconst fecha = extracted.fecha || null;\nconst valido = operacion.length >= 6 && !!base.pedido_id;\nreturn [{ json: Object.assign({}, base, { operacion: operacion, monto: monto, fecha: fecha, comprobante_valido: valido }) }];"
