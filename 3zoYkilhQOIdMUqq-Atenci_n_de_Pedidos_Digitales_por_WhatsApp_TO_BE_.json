      "parameters": {
        "jsCode": "const base = $('Determinar Fase').first().json;\nconst t = (base.texto || '').toLowerCase().trim();\nconst noWords = ['no', 'cancelar', 'luego', 'despues', 'después', 'mejor no', 'ya no', 'nel'];\nconst siWords = ['si', 'sí', 'claro', 'ok', 'dale', 'quiero', 'confirmo', 'comprar', 'yes', 'listo', 'va', 'acepto'];\nlet decision = 'no';\nconst isNo = noWords.some(function(w){ return t === w || t.indexOf(w) === 0; });\nconst isSi = siWords.some(function(w){ return t.indexOf(w) !== -1; });\nif (isNo) { decision = 'no'; } else if (isSi) { decision = 'si'; }\nreturn [{ json: Object.assign({}, base, { decision: decision }) }];"
      },
