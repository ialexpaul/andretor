        "jsCode": "const v = $input.first().json || {};\nconst msg = (v.messages && v.messages[0]) || {};\nconst meta = v.metadata || {};\nlet texto = '';\nif (msg.text && msg.text.body) { texto = msg.text.body; }\nelse if (msg.button && msg.button.text) { texto = msg.button.text; }\nelse if (msg.interactive && msg.interactive.list_reply) { texto = msg.interactive.list_reply.title; }\nconst tipo = msg.type || 'text';\nlet media_id = '';\nif (tipo === 'image' && msg.image) { media_id = msg.image.id || ''; }\nelse if (tipo === 'document' && msg.document) { media_id = msg.document.id || ''; }\nreturn [{ json: {\n  telefono: msg.from || '',\n  texto: texto,\n  tipo: tipo,\n  media_id: media_id,\n  message_id: msg.id || '',\n  phone_number_id: meta.phone_number_id || '',\n  timestamp: msg.timestamp || ''\n} }];"
