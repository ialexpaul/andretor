      "parameters": {
        "description": "Verifica si el mensaje del cliente es una consulta valida de productos del catalogo. Pasa el texto del mensaje del cliente. Devuelve JSON con { valida: boolean, motivo, texto }.",
        "jsCode": "const q = (query || \"\").toString().trim();\nif (!q) {\n  return JSON.stringify({ valida: false, motivo: \"Mensaje vacio o sin contenido interpretable\" });\n}\nif (q.length < 2) {\n  return JSON.stringify({ valida: false, motivo: \"Mensaje demasiado corto para interpretar una solicitud\" });\n}\nreturn JSON.stringify({ valida: true, motivo: \"Solicitud interpretable\", texto: q });"
      },
