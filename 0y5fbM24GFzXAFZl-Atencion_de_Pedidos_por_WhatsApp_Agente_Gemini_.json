    {
      "parameters": {
        "description": "Valida el comprobante de pago enviado por el cliente. Pasa el codigo/numero de operacion del comprobante (o la descripcion del archivo). Devuelve JSON con { valido: boolean, motivo, comprobante }. Regla: valido si tiene 6 o mas caracteres.",
        "jsCode": "const c = (query || \"\").toString().trim();\nif (!c) {\n  return JSON.stringify({ valido: false, motivo: \"No se recibio ningun comprobante\" });\n}\nconst valido = c.replace(/\\s+/g, \"\").length >= 6;\nreturn JSON.stringify({\n  valido,\n  comprobante: c,\n  motivo: valido ? \"Comprobante valido\" : \"Comprobante invalido: debe tener al menos 6 caracteres\"\n});"
      },
