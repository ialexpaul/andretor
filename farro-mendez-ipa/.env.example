# ==========================================
# FARRO MENDEZ CORPORATION S.A.C. - IPA
# Variables de Entorno de Configuración
# ==========================================

# Base de datos PostgreSQL (AsyncPG para SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/farro_mendez

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_API_TOKEN=TU_TOKEN_AQUI
WHATSAPP_PHONE_NUMBER_ID=TU_PHONE_NUMBER_ID_AQUI
WHATSAPP_VERIFY_TOKEN=TU_VERIFY_TOKEN_AQUI
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# Google Gemini API
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI
GEMINI_MODEL=gemini-2.5-flash

# Configuración general de ejecución
# FLOW_MODE: 'rpa' (flujo determinista) o 'agentic' (flujo autónomo con LangChain)
FLOW_MODE=rpa
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
